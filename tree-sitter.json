{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "synquid",
      "camelcase": "Synquid",
      "title": "Synquid",
      "scope": "source.synquid",
      "file-types": [
        "sq"
      ],
      "injection-regex": "^synquid$",
      "class-name": "TreeSitterSynquid"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Synquid grammar for tree-sitter",
    "authors": [
      {
        "name": "Lemuel DLS",
        "email": "noreply@git.lemueldls.dev",
        "url": "https://lemueldls.dev"
      }
    ],
    "links": {
      "repository": "https://github.com/lemueldls/tree-sitter-synquid",
      "funding": "https://github.com/lemueldls"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
